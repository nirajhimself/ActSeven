{
  "name": "act-vii-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-db.mjs next dev",
    "dev:stop": "node scripts/stop-dev.mjs",
    "build": "node scripts/with-db.mjs --memory next build",
    "start": "node scripts/with-db.mjs next start",
    "lint": "eslint",
    "test": "node scripts/with-db.mjs --isolated tsx --require ./tests/setup/server-only.cjs --test --test-concurrency=1 tests/database.test.ts tests/shopping.test.ts",
    "db:setup": "node scripts/with-db.mjs prisma migrate deploy && node scripts/with-db.mjs prisma db seed",
    "postinstall": "prisma generate",
    "db:migrate": "node scripts/with-db.mjs prisma migrate deploy",
    "db:seed": "node scripts/with-db.mjs prisma db seed",
    "db:studio": "node scripts/with-db.mjs prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "next": "16.4.2",
    "pg": "8.23.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5"
  }
}
