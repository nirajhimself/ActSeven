# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string (local Postgres, Neon, Supabase, …)
# e.g. postgres://postgres:YOUR_PASSWORD@localhost:5432/act_vii
# Leave empty for local development: `npm run dev` then starts a local sample
# database (.data/pglite) with migrations and sample data applied.
# Supabase: use the transaction pooler (port 6543) here.
DATABASE_URL=
# Optional: connection used by Prisma migrations. Supabase: the session pooler
# or direct connection (port 5432). Defaults to DATABASE_URL.
DIRECT_URL=

# Razorpay — Dashboard → Account & Settings → API Keys (use TEST keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret you set for /api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# Order emails via Resend (resend.com) — optional; emails are skipped if unset.
RESEND_API_KEY=
# Must be on a domain you've verified in Resend, e.g. "ACT VII <orders@actvii.in>"
EMAIL_FROM=
# Public site URL used in email links, e.g. https://actvii.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin dashboard at /admin (HTTP Basic auth). Disabled unless the password is 12+ characters.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Customer sign-in: random secret (32+ chars) used to hash one-time codes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Secret for the scheduled clean-up of abandoned payments (16+ random characters).
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
